# Copy this file to .env for local Docker Compose only.
# This configuration is for a deterministic demonstration, not production.
ENVIRONMENT=development
POSTGRES_PASSWORD=govcheck
DATABASE_URL=postgresql+asyncpg://govcheck:govcheck@postgres:5432/govcheck

# fake: deterministic test fixture; groq: hosted LLM; ollama: local LLM.
LLM_PROVIDER=fake
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Set both EMBEDDING_PROVIDER=sentence-transformer and INSTALL_EMBEDDINGS=true
# for real multilingual embeddings. The first run downloads model weights.
EMBEDDING_PROVIDER=fake
INSTALL_EMBEDDINGS=false
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384

NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
ANALYSIS_JOB_TIMEOUT_MINUTES=10
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_CLIENT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_KEYS=10000
